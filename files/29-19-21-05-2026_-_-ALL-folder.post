const problemSection = [
  h1("3. Problem Statement"),
  p("Traditional home automation systems suffer from several critical limitations that reduce their practicality and adoption rate:"),
  bullet("Manual switching: Conventional light switches, fans, and appliance controls require physical interaction, limiting accessibility for mobility-impaired users."),
  bullet("Cost barriers: Commercially available smart home systems (e.g., Phillips Hue, SmartThings) involve expensive proprietary hardware and ongoing subscription fees."),
  bullet("Internet dependency: Most cloud-based voice assistants require stable internet connections, making them unreliable in areas with poor connectivity."),
  bullet("Privacy concerns: Continuous cloud listening raises significant data privacy risks, as user voice data is processed and stored on remote servers."),
  bullet("Complex installation: Many smart home systems require complete rewiring or replacement of existing electrical infrastructure."),
  bullet("Limited customizability: Commercial systems restrict user modifications, preventing integration of domain-specific commands or local language support."),
  space(1),
  p("The proposed system addresses each of these limitations by offering an AI-powered, locally processed, USB relay-based home automation platform that is affordable, privacy-preserving, and adaptable to various home configurations."),
  space(1),
  pageBreak()
];

