// Section 11 - Circuit Design
const circuitSection = [
  h1("11. Circuit Design and Relay Control"),
  h2("11.1 USB Relay Circuit Overview"),
  p("The USB relay module is connected between the computer/Raspberry Pi and the electrical load. The circuit consists of three electrically isolated zones:"),
  numbered("USB Control Zone (5V DC): The computer-side circuit powered by the USB port. This zone handles digital signals and HID communication."),
  numbered("Relay Coil Zone (5V/12V DC): The relay coil is energized by the control signal, mechanically actuating the relay switch. This zone is optocoupler-isolated from the USB zone."),
  numbered("Load Zone (110V/220V AC): The high-voltage zone where the actual appliance is connected. The relay contact provides physical isolation from the control electronics."),
  space(1),
  h2("11.2 Safety and Isolation"),
  p("Electrical safety is paramount in this design. The USB relay module achieves isolation through:"),
  bullet("Optocoupler isolation: Each relay channel uses an optocoupler (e.g., PC817) to isolate the USB control signal from the relay coil, providing 1000V+ isolation voltage."),
  bullet("Physical relay contact isolation: Mechanical relays provide physical separation between the control circuit and the AC load circuit, eliminating any electrical pathway between them."),
  bullet("Fused load connections: Each relay output is protected by an appropriate fuse (typically 10A) to prevent overload damage."),
  bullet("Earthing: All metal enclosures are properly earthed to prevent shock hazard."),
  space(1),
  h2("11.3 Wiring Configuration"),
  makeTable(
    ["Connection", "Wire Type", "Specification", "Safety Note"],
    [
      ["USB to relay module", "USB-A to Micro/Type-B", "USB 2.0 compatible", "Use shielded cable for EMI reduction"],
      ["Relay to light fixture", "Single-core PVC wire", "1.5mm², 250V rated", "Route away from data cables"],
      ["Relay to fan", "Single-core PVC wire", "2.5mm², 250V rated", "Use proper conduit"],
      ["Relay to AC socket", "Flexible PVC cord", "3-core, 2.5mm²", "Must be earth-connected"],
      ["Power supply to board", "DC barrel connector", "5V, 3A minimum", "Use regulated supply"],
    ],
    [2200, 2000, 2200, 2960]
  ),
  space(1),
  h2("11.4 Channel Assignment"),
  p("The relay channels are assigned to appliances based on room and priority. A typical 4-channel assignment for a bedroom is:"),
  bullet("Channel 1: Main light (ceiling bulb/tube light)"),
  bullet("Channel 2: Ceiling fan"),
  bullet("Channel 3: Table lamp / reading light"),
  bullet("Channel 4: Air conditioner (AC) — 1-ton or less on 10A relay"),
  space(1),
  pageBreak()
];

// Section 12 - Speech Recognition Pipeline
const nlpSection = [
  h1("12. Speech Recognition and NLP Pipeline"),
  h2("12.1 Audio Preprocessing"),
  p("Raw audio captured by the microphone undergoes several preprocessing steps before being fed to the STT engine:"),
  numbered("Noise reduction: Background noise filtering using spectral subtraction or Wiener filtering algorithms (implemented via noisereduce Python library)."),
  numbered("Voice Activity Detection (VAD): Identifies speech segments and discards silence, reducing processing load and improving recognition accuracy."),
  numbered("Normalization: Audio amplitude is normalized to a consistent level (typically -20 dBFS) for optimal STT performance."),
  numbered("Resampling: Audio is resampled to the STT engine's preferred sample rate (16kHz for Whisper)."),
  space(1),
  h2("12.2 Intent Classification"),
  p("After transcription, the text undergoes a multi-stage NLP pipeline:"),
  h3("Stage 1: Tokenization and Normalization"),
  p("The text is converted to lowercase, punctuation is removed, and common contractions are expanded (e.g., 'don't' to 'do not'). Stopwords may be removed for efficiency in rule-based systems."),
  h3("Stage 2: Intent Detection"),
  p("The primary intent is classified into one of the defined action categories:"),
  makeTable(
    ["Intent Category", "Example Phrases", "Action"],
    [
      ["TURN_ON", "turn on, switch on, start, enable, activate", "Set relay to HIGH (closed)"],
      ["TURN_OFF", "turn off, switch off, stop, disable, shut down", "Set relay to LOW (open)"],
      ["TOGGLE", "toggle, flip, change state", "Invert current relay state"],
      ["STATUS_QUERY", "what is, is it on, check status", "Read and speak current state"],
      ["ALL_ON", "everything on, all lights on", "Set all relay channels HIGH"],
      ["ALL_OFF", "everything off, good night, sleep mode", "Set all relay channels LOW"],
    ],
    [2000, 3500, 3860]
  ),
  space(1),
  h3("Stage 3: Entity Extraction"),
  p("Appliance names and room identifiers are extracted as named entities. A custom entity dictionary maps common names and synonyms to relay channel identifiers:"),
  bullet("Light/lights/bulb/tube → Channel 2 (or room-specific channel)"),
  bullet("Fan/ceiling fan/air circulation → Channel 3"),
  bullet("AC/air conditioner/cooling → Channel 4"),
  bullet("Everything/all appliances → All channels"),
  space(1),
  h2("12.3 Wake Word Detection"),
  p("An optional wake word detection module (using Porcupine or custom keyword spotting) can be integrated to activate the system only when a specific trigger phrase is spoken (e.g., 'Hey System', 'Computer', 'Smart Home'). This reduces continuous audio processing overhead and improves battery life in portable implementations."),
  space(1),
  pageBreak()
];

